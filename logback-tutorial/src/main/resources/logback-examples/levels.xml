<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- DEBUG for every class in the library package -->
  <logger name="com.howtodoinjava.demo.logback.library" level="DEBUG"/>
  <!-- but only WARN and above from CatalogService -->
  <logger name="com.howtodoinjava.demo.logback.library.CatalogService" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
